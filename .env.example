# Set as many of these three as you like. If CHAT_PROVIDER is unset, every
# provider with a key configured is tried in order — Anthropic, then
# OpenAI, then Gemini — and the first one that succeeds answers the
# request. So if e.g. Anthropic runs out of credits, the request
# automatically falls through to the next configured provider instead of
# failing. Set CHAT_PROVIDER to force a single provider with no fallback.

# Anthropic — get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI — get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini if unset. Use a vision-capable model
# (e.g. gpt-4o, gpt-4o-mini) so the photo-upload feature keeps working.
OPENAI_MODEL=gpt-4o-mini

# Gemini — get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# Optional — force which single provider handles chat requests, with no
# fallback: "anthropic", "openai", or "gemini". Leave unset for the
# auto-cascading behavior described above.
CHAT_PROVIDER=
