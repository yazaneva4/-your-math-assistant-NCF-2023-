# Set ONE OR BOTH of these. If both are set, CHAT_PROVIDER picks which one
# answers chat requests; if CHAT_PROVIDER is unset, Anthropic is used first
# when present, otherwise OpenAI.

# Anthropic — get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5 if unset
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI — get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — defaults to gpt-4o-mini if unset. Use a vision-capable model
# (e.g. gpt-4o, gpt-4o-mini) so the photo-upload feature keeps working.
OPENAI_MODEL=gpt-4o-mini

# Optional — force which provider handles chat requests: "anthropic" or
# "openai". Leave unset to auto-pick based on which key(s) above are set.
CHAT_PROVIDER=
